{
  "$defs": {
    "ApprovalLevel": {
      "enum": [
        "NONE",
        "SAMPLED_QA",
        "SINGLE_REVIEWER",
        "MAKER_CHECKER"
      ],
      "title": "ApprovalLevel",
      "type": "string"
    },
    "AutomationLevel": {
      "enum": [
        "ASSISTED",
        "SUPERVISED_AUTONOMOUS",
        "AUTONOMOUS"
      ],
      "title": "AutomationLevel",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "description": "A typed, optionally version-pinned pointer to another entity.",
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        },
        "version": {
          "anyOf": [
            {
              "examples": [
                "1.0.0",
                "2.1.0-rc.1"
              ],
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pin to an exact version. None means 'whatever is current'.",
          "title": "Version"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EntityType": {
      "description": "Every entity type in the metamodel, across both twins.\n\n``EntityRef`` and the relationship-type registry validate against this, so a\ntypo in a reference or a registry file fails loudly instead of creating a\ndangling edge.",
      "enum": [
        "Project",
        "Repository",
        "CodeArtifact",
        "Pipeline",
        "DataAsset",
        "SchemaDefinition",
        "DataProfile",
        "Infrastructure",
        "CloudResource",
        "ArchitectureElement",
        "Test",
        "Incident",
        "Change",
        "Deployment",
        "DeliveryModel",
        "DeliveryPhase",
        "DeliveryTask",
        "DeliveryActivity",
        "DeliveryArtifact",
        "DeliveryInput",
        "DeliveryOutput",
        "DeliveryProcess",
        "DeliveryContract",
        "Checklist",
        "ChecklistItem",
        "AcceptanceCriterion",
        "ApprovalGate",
        "ApprovalRule",
        "Approval",
        "EvidenceRequirement",
        "DefinitionOfDone",
        "Standard",
        "Template",
        "Methodology",
        "Control",
        "RaciAssignment",
        "DeliveryRole",
        "EngineeringResponsibility",
        "EngineeringRole",
        "Agent",
        "Skill",
        "Tool",
        "KnowledgePack",
        "Policy",
        "Problem",
        "Requirement",
        "Capability",
        "DeliveryCapability",
        "CapabilityGap",
        "Workflow",
        "Task",
        "Artifact",
        "Event",
        "Decision",
        "Observation",
        "Evaluation",
        "EvaluationSuite",
        "EvaluationScenario",
        "EvaluationMetric",
        "Evidence",
        "Finding",
        "Platform",
        "TechnologyBinding",
        "Memory",
        "ContextPolicy",
        "ContextBundle",
        "ContextItem",
        "ProjectSnapshot",
        "EngineeringObservation",
        "EngineeringPattern",
        "CandidateSkill",
        "CandidateTool",
        "CandidateAgent"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "RiskClass": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "Twin": {
      "description": "Which dimension of the digital twin an entity belongs to.\n\nBoth dimensions share one graph and one provenance model; this is a label\nfor navigation and reporting, not a partition. See ADR-0008.",
      "enum": [
        "TECHNICAL",
        "DELIVERY",
        "SHARED"
      ],
      "title": "Twin",
      "type": "string"
    }
  },
  "$id": "https://agentic-data-engineering/schemas/EngineeringRole.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A required engineering function, stated independently of who performs it.\n\nThe stable abstraction agents are composed against and evaluations certify.\nWorkflows and contracts bind to role keys, never to agent ids, so replacing\nan agent touches one edge.",
  "properties": {
    "attributes": {
      "additionalProperties": true,
      "description": "Adapter-specific detail that has not earned a first-class field yet.",
      "title": "Attributes",
      "type": "object"
    },
    "automation_level": {
      "$ref": "#/$defs/AutomationLevel",
      "default": "ASSISTED"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "default_approval_level": {
      "$ref": "#/$defs/ApprovalLevel",
      "default": "SINGLE_REVIEWER"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "entity_type": {
      "$ref": "#/$defs/EntityType",
      "default": "EngineeringRole"
    },
    "evaluation_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Evaluation Criteria",
      "type": "array"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "inputs": {
      "items": {
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "kpis": {
      "items": {
        "type": "string"
      },
      "title": "Kpis",
      "type": "array"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "title": "Labels",
      "type": "array"
    },
    "metamodel_version": {
      "default": "0.1.0",
      "examples": [
        "1.0.0",
        "2.1.0-rc.1"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "title": "Metamodel Version",
      "type": "string"
    },
    "minimum_delivery_conformance": {
      "default": 0.9,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Minimum Delivery Conformance",
      "type": "number"
    },
    "minimum_evaluation_score": {
      "default": 0.8,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Minimum Evaluation Score",
      "type": "number"
    },
    "mission": {
      "minLength": 1,
      "title": "Mission",
      "type": "string"
    },
    "name": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "outputs": {
      "items": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "policy_refs": {
      "items": {
        "$ref": "#/$defs/EntityRef"
      },
      "title": "Policy Refs",
      "type": "array"
    },
    "required_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "required_delivery_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Delivery Capabilities",
      "type": "array"
    },
    "required_knowledge": {
      "items": {
        "type": "string"
      },
      "title": "Required Knowledge",
      "type": "array"
    },
    "required_skills": {
      "items": {
        "type": "string"
      },
      "title": "Required Skills",
      "type": "array"
    },
    "required_tools": {
      "items": {
        "type": "string"
      },
      "title": "Required Tools",
      "type": "array"
    },
    "responsibilities": {
      "description": "EngineeringResponsibility keys this role fulfils.",
      "items": {
        "type": "string"
      },
      "title": "Responsibilities",
      "type": "array"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskClass",
      "default": "MEDIUM"
    },
    "role_key": {
      "minLength": 1,
      "title": "Role Key",
      "type": "string"
    },
    "twin": {
      "$ref": "#/$defs/Twin",
      "default": "SHARED"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "version": {
      "default": "0.1.0",
      "examples": [
        "1.0.0",
        "2.1.0-rc.1"
      ],
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "role_key",
    "mission"
  ],
  "title": "EngineeringRole",
  "type": "object",
  "x-metamodel-version": "0.1.0",
  "x-twin": "SHARED"
}
